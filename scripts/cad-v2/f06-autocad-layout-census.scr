(defun f06-count-block-entities (blockName / blockRecord entity entityData count viewportCount)
  (setq blockRecord (tblobjname "BLOCK" blockName))
  (setq entity (if blockRecord (entnext blockRecord)))
  (setq count 0)
  (setq viewportCount 0)
  (while (and entity (setq entityData (entget entity)) (/= (cdr (assoc 0 entityData)) "ENDBLK"))
    (setq count (1+ count))
    (if (= (cdr (assoc 0 entityData)) "VIEWPORT")
      (setq viewportCount (1+ viewportCount))
    )
    (setq entity (entnext entity))
  )
  (list blockName count viewportCount)
)

(defun c:F06AUDIT (/ blockName result)
  (princ "\nF06_AUTOCAD_CENSUS_BEGIN")
  (princ (strcat "\nACADVER=" (getvar "ACADVER")))
  (princ (strcat "\nSOURCE=" (getvar "DWGNAME")))
  (foreach blockName '("*Model_Space" "*Paper_Space" "*Paper_Space0" "*Paper_Space1" "*Paper_Space2")
    (setq result (f06-count-block-entities blockName))
    (princ (strcat "\nBLOCK=" blockName ";entities=" (itoa (cadr result)) ";viewports=" (itoa (caddr result))))
  )
  (princ "\nF06_AUTOCAD_CENSUS_END")
  (princ)
)

F06AUDIT
