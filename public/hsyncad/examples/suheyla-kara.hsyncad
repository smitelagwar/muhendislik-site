470928},{"x":3.900000000000011,"y":25.08315153744457},{"x":3.850000000000012,"y":25.083151537444564},{"x":3.850000000000012,"y":22.18315153744458},{"x":9.84999999999999,"y":22.18315153744458}],"footprint":[{"x":9.849999999999962,"y":24.707629612123085},{"x":7.985429638401158,"y":24.900101477842036},{"x":3.900000000000018,"y":25.33175995470928},{"x":3.900000000000011,"y":25.08315153744457},{"x":3.850000000000012,"y":25.083151537444564},{"x":3.850000000000012,"y":22.18315153744458},{"x":9.84999999999999,"y":22.18315153744458}],"sourceOffset":45234383,"primitiveType":7,"layerId":66,"nativeZ":0,"lateralOffset":0,"rotation":0,"thickness":0.15,"planAnnotation":{"loads":{"dead":0.545,"live":0.5,"unit":"tf/m²","sourceOffset":45234868},"designAxes":[{"points":[{"x":3.850000000000012,"y":23.44539057478377},{"x":9.849999999999977,"y":23.44539057478377}],"direction":"x","sourceOffset":45235163},{"points":[{"x":6.850000000000011,"y":22.18315153744458},{"x":6.8499999999999766,"y":25.02006874485731}],"direction":"y","sourceOffset":45239002}]},"foundation":false,"top":0.3999999999999999,"bottom":0.24999999999999992,"verticalSource":"storey-derived"}],"coverage":{"candidateRecords":2701,"decodedRecords":2171,"unsupportedRecords":0,"ignoredTemplateRecords":0,"holeRecords":107,"rejectedCandidates":423,"byType":{"axis":366,"wall":92,"line":60,"slab":299,"section":14,"beam":778,"column":390,"slabEdge":163,"stair":9},"unsupportedTypes":{},"limitations":["Kayıt sayıları yalnız tanınan ad/renk/geometri gramerinin adaylarını kapsar. Desteklenmeyen kayıt sayısının sıfır olması tüm dosyanın eksiksiz okunduğunu göstermez; diğer nesne sınıflarının toplamı bilinmiyor.","Plan konumları, kat kotları ve yükseklikleri, kesit genişlikleri, yanal kaçıklıklar ve döşeme boşlukları dosyadan okunur.","Bant kirişler kaynak plan genişliği ve kaçıklığıyla, kesit işaretleri kaynak çizgisiyle gösterilir. Bu iki türün 3B gövdesi, özel kotu, kesit okları ve kesit çizimi henüz doğrulanmamıştır.","Merdivenler dosyada saklanan yerel XYZ düğümleri ve dört düğümlü bağlantılardan analiz yüzeyi olarak okunur; basamak, kaplama, korkuluk veya kapalı katı gövde eşdeğerliği iddia edilmez.","Saklanan merdiven analiz ağının son model düzenlemesiyle güncelliği henüz doğrulanmamıştır. Statik hesap sonuçları, donatı çizimleri ve paftalar görüntülenmez.","Duvar yüksekliği ve gözlenen dikdörtgen kolon/perde ailelerinin özel üst kotları kaynak kayıttan okunur. Diğer taşıyıcıların 3B sınırları kat aralıklarından ve kiriş kesitinden türetilir. Özel kot ailelerinin tamamı henüz çözümlenmemiştir.","Native daire işareti, yarıçap alanı ve kayıtlı çevre noktaları birlikte doğrulandığında daire kesiti korunur; görüntüleyici konturu bu yarıçaptan türetilir, özgün plan noktaları ayrıca saklanır.","Bu görünüm incelenmiş eleman türlerini kapsar; dosyanın bütün özelliklerinin ideCAD ile aynı açıldığı anlamına gelmez."]},"warnings":["Bu görünüm yerel IDE plan verilerinden üretilmiştir. ideCAD ile tam görsel ve hesap eşdeğerliği doğrulanmış değildir."]},"mappedIds":["ide-floor-0:1053300","ide-floor-0:1053301","ide-floor-0:1053302","ide-floor-0:1053303","ide-floor-0:1053304","ide-floor-0:1053305","ide-floor-0:1053566","ide-floor-1:792266","ide-floor-1:792267","ide-floor-1:792268","ide-floor-1:792269","ide-floor-1:792270","ide-floor-1:792271","ide-floor-1:792272","ide-floor-1:792273","ide-floor-1:792274","ide-floor-1:792275","ide-floor-1:792276","ide-floor-1:792277","ide-floor-1:792278","ide-floor-1:792279","ide-floor-1:792280","ide-floor-1:792281","ide-floor-1:792282","ide-floor-1:792283","ide-floor-1:792289","ide-floor-1:792294","ide-floor-1:792297","ide-floor-1:792301","ide-floor-1:792303","ide-floor-1:792306","ide-floor-1:792309","ide-floor-1:792313","ide-floor-1:792314","ide-floor-1:792315","ide-floor-1:792316","ide-floor-1:792317","ide-floor-1:792318","ide-floor-1:792320","ide-floor-1:792322","ide-floor-1:792323","ide-floor-1:792324","ide-floor-1:792325","ide-floor-1:792326","ide-floor-1:792327","ide-f