{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": {
      "internal-*": false,
      "chatgpt-*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/belge-paylasim-temizlik",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/vendor/pdfjs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
