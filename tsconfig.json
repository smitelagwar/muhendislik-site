{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-playwright/types/**/*.ts",
    ".next-playwright/dev/types/**/*.ts",
    ".next-playwright-3108/types/**/*.ts",
    ".next-playwright-3108/dev/types/**/*.ts",
    ".next-playwright-3109/types/**/*.ts",
    ".next-playwright-3109/dev/types/**/*.ts",
    ".next-playwright-3110/types/**/*.ts",
    ".next-playwright-3110/dev/types/**/*.ts",
    ".next-playwright-3111/types/**/*.ts",
    ".next-playwright-3111/dev/types/**/*.ts",
    ".next-playwright-3112/types/**/*.ts",
    ".next-playwright-3112/dev/types/**/*.ts",
    ".next-playwright-3113/types/**/*.ts",
    ".next-playwright-3113/dev/types/**/*.ts",
    ".next-playwright-3114/types/**/*.ts",
    ".next-playwright-3114/dev/types/**/*.ts",
    ".next-playwright-3115/types/**/*.ts",
    ".next-playwright-3115/dev/types/**/*.ts",
    ".next-playwright-3117/types/**/*.ts",
    ".next-playwright-3117/dev/types/**/*.ts",
    ".next-playwright-3118/types/**/*.ts",
    ".next-playwright-3118/dev/types/**/*.ts",
    ".next-playwright-3119/types/**/*.ts",
    ".next-playwright-3119/dev/types/**/*.ts",
    ".next-playwright-3120/types/**/*.ts",
    ".next-playwright-3120/dev/types/**/*.ts",
    ".next-playwright-3121/types/**/*.ts",
    ".next-playwright-3121/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scratch"
  ]
}
