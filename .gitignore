# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# private DXF fidelity corpus; README is safe to commit, project drawings are not
/tests/private-dxf-corpus/*
!/tests/private-dxf-corpus/README.md

# private DWG golden corpus; real project drawings and local baseline manifest stay local
/tests/private-dwg-corpus/*
!/tests/private-dwg-corpus/README.md
!/tests/private-dwg-corpus/manifest.example.json

# manual PDF test fixtures; README is safe to commit, user provided files are not
/tests/fixtures/pdf/manual/*
!/tests/fixtures/pdf/manual/README.md

# next.js
/.next*/
/out/

# production
/build
/public/workers/
/public/cad-upstream/


# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local helper content / generated artifacts
.agent/
logolar/
eklediklerim/*
!eklediklerim/ornek_dosyalar/
get-shit-done/
-EKLEDİKLERİM/
.tmp/
output.html
lint.txt
lint_output.txt
snapshot*.png
puppeteer*.js
test_scrollytelling.js
.next-dev.err.log
.next-dev.out.log
*.log
scratch/
.data/
.test-data/
.gorsel-cikti-ham/
$cacheRoot/
test-output/
scripts/cad-v2/
tests/visual-inspection/
docs/pdf-zoom-v2-screenshots/

.vercel
.env*
