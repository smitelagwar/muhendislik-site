# ============================================================================
# GENEL SİTE KONFİGÜRASYONU
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://muhendislik-site.vercel.app

# ============================================================================
# DÖKÜMANTASYON MODÜLÜ — ADMIN VE GÜVENLİK
# ============================================================================
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
# Generate outside source control: bcrypt hash for ADMIN_USERNAME's password.
ADMIN_PASSWORD_HASH=CHANGE_ME_VALID_BCRYPT_HASH
# Generate a unique random value of at least 32 UTF-8 bytes; never commit it.
SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET_AT_LEAST_32_BYTES
ADMIN_SESSION_VERSION=1

# Rate limiting IP fingerprint salt
# Generate a unique random value of at least 32 UTF-8 bytes; never commit it.
RATE_LIMIT_SALT=CHANGE_ME_RANDOM_RATE_LIMIT_SALT_AT_LEAST_32_BYTES

# ============================================================================
# VERİTABANI — NEON POSTGRES (Vercel Marketplace)
# ============================================================================
DATABASE_URL=postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# DEPOLAMA — VERCEL BLOB (Private Store)
# ============================================================================
# Vercel'e bağlı OIDC Blob store'un kimliği. Production'da zorunludur.
BLOB_STORE_ID=CHANGE_ME_VERCEL_BLOB_STORE_ID
# Vercel Blob upload-completed callback imza doğrulama açık anahtarı. Production'da zorunludur.
BLOB_WEBHOOK_PUBLIC_KEY=CHANGE_ME_VERCEL_BLOB_WEBHOOK_PUBLIC_KEY
# Yalnız yerel geliştirme / Vercel dışı CLI uyumluluğu için legacy fallback; Production'a eklemeyin.
BLOB_READ_WRITE_TOKEN=CHANGE_ME_LOCAL_LEGACY_BLOB_TOKEN

# ============================================================================
# DÖKÜMANTASYON DAVRANIŞ AYARLARI
# ============================================================================
DOK_MAX_FILE_SIZE_MB=100
# Opsiyonel: Aktif linklerin admin tarafından tekrar kopyalanması için AES-GCM anahtarı
SHARE_TOKEN_ENCRYPTION_KEY=

# ============================================================================
# YEREL GELİŞTİRME (LOCAL ONLY — VERCEL'DE HER ZAMAN ETKİSİZDİR)
# ============================================================================
# Yerel geliştirme ortamında Neon ve Blob olmadan .data/ klasörüne izin vermek için true yapın
DOK_ALLOW_LOCAL_STORAGE=false
